    crisp type mismatch instead of a `whnf` timeout. -/
@[irreducible] def K055 : Nat := 45505331745

def dep055 : Nat := 12

/-- The undecided pairs shared by every depth-12 frontier state. -/
abbrev PS055 : List (Nat × Nat) := (pairList 9).drop dep055

/-- The depth-12 frontier, as a literal `List Nat`. -/
