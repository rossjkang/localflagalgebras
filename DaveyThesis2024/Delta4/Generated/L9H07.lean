/-- One rung of this mask's frontier count ladder; O(1). -/
theorem step055 {a b c : Nat} (h : a + b = c) {x y z : Nat}
    (hc : goAllPCnt pruneOK leafOK 9 K055 PS055 ((F055.drop a).take b) = (x, 0))
    (hr : goAllPCnt pruneOK leafOK 9 K055 PS055 (F055.drop c) = (y, 0))
    (hs : x + y = z) :
    goAllPCnt pruneOK leafOK 9 K055 PS055 (F055.drop a) = (z, 0) := by
  rw [goAllPCnt_peel pruneOK leafOK 9 K055 PS055 F055 a b c h, hc, hr]
  subst hs
  rfl

