  decide +kernel

/-- The internal nodes above the frontier: a second, independent kernel fact. -/
theorem F165_internal :
    expandPNodes pruneOK 8 K165 dep165 (pairList 8) 0 = 27 := by
  decide +kernel

theorem F165_residual : F165.drop 12 = [] := by decide +kernel

/-- One rung of this mask's frontier count ladder; O(1). -/
theorem step165 {a b c : Nat} (h : a + b = c) {x y z : Nat}
    (hc : goAllPCnt pruneOK leafOK 8 K165 PS165 ((F165.drop a).take b) = (x, 0))
    (hr : goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop c) = (y, 0))
    (hs : x + y = z) :
    goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop a) = (z, 0) := by
  rw [goAllPCnt_peel pruneOK leafOK 8 K165 PS165 F165 a b c h, hc, hr]
  subst hs
  rfl

/-- mask 165, frontier chunk 0: states [0, 2), 1804 nodes. -/
theorem c165_0 :
    goAllPCnt pruneOK leafOK 8 K165 PS165 ((F165.drop 0).take 2) = (1804, 0) := by
  decide +kernel

/-- mask 165, frontier chunk 1: states [2, 3), 1333 nodes. -/
theorem c165_1 :
    goAllPCnt pruneOK leafOK 8 K165 PS165 ((F165.drop 2).take 1) = (1333, 0) := by
  decide +kernel

/-- mask 165, frontier chunk 2: states [3, 5), 2264 nodes. -/
theorem c165_2 :
    goAllPCnt pruneOK leafOK 8 K165 PS165 ((F165.drop 3).take 2) = (2264, 0) := by
  decide +kernel

/-- mask 165, frontier chunk 3: states [5, 7), 2436 nodes. -/
theorem c165_3 :
    goAllPCnt pruneOK leafOK 8 K165 PS165 ((F165.drop 5).take 2) = (2436, 0) := by
  decide +kernel

/-- mask 165, frontier chunk 4: states [7, 9), 2237 nodes. -/
theorem c165_4 :
    goAllPCnt pruneOK leafOK 8 K165 PS165 ((F165.drop 7).take 2) = (2237, 0) := by
  decide +kernel

/-- mask 165, frontier chunk 5: states [9, 11), 2330 nodes. -/
theorem c165_5 :
    goAllPCnt pruneOK leafOK 8 K165 PS165 ((F165.drop 9).take 2) = (2330, 0) := by
  decide +kernel

/-- mask 165, frontier chunk 6: states [11, 12), 1638 nodes. -/
theorem c165_6 :
    goAllPCnt pruneOK leafOK 8 K165 PS165 ((F165.drop 11).take 1) = (1638, 0) := by
  decide +kernel

/-! ### mask index 165: the 7 chunk counts, chained, and the mask's node count.
    Nothing here traverses the tree: each rung is one `step165`. -/

theorem s165_7 : goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop 12) = (0, 0) := by
  rw [F165_residual]
  rfl

theorem s165_6 : goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop 11) = (1638, 0) :=
  step165 (b := 1) (c := 12) rfl c165_6 s165_7 rfl

theorem s165_5 : goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop 9) = (3968, 0) :=
  step165 (b := 2) (c := 11) rfl c165_5 s165_6 rfl

theorem s165_4 : goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop 7) = (6205, 0) :=
  step165 (b := 2) (c := 9) rfl c165_4 s165_5 rfl

theorem s165_3 : goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop 5) = (8641, 0) :=
  step165 (b := 2) (c := 7) rfl c165_3 s165_4 rfl

theorem s165_2 : goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop 3) = (10905, 0) :=
  step165 (b := 2) (c := 5) rfl c165_2 s165_3 rfl

theorem s165_1 : goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop 2) = (12238, 0) :=
  step165 (b := 1) (c := 3) rfl c165_1 s165_2 rfl

theorem s165_0 : goAllPCnt pruneOK leafOK 8 K165 PS165 (F165.drop 0) = (14042, 0) :=
  step165 (b := 2) (c := 2) rfl c165_0 s165_1 rfl

/-- **The node count of the whole mask, derived** from the 7 chunk declarations
    and `F165_internal` via `goGCnt_fst_eq`/`goGCnt_snd_eq`. -/
theorem mask165_count : searchPCnt 8 K165 = (14069, 0) := by
  have hfc : goAllPCnt pruneOK leafOK 8 K165 PS165
      (expandP pruneOK 8 K165 dep165 (pairList 8) 0) = (14042, 0) := by
    have h := s165_0
    rw [List.drop_zero] at h
    rw [F165_eq]
    exact h
  have h1 := goGCnt_fst_eq pruneOK leafOK 8 K165 dep165 (pairList 8) 0
  have h2 := goGCnt_snd_eq pruneOK leafOK 8 K165 dep165 (pairList 8) 0
  simp only [hfc, F165_internal] at h1 h2
  exact Prod.ext h1 h2

